# ==============================================================================
# ECONODE STUDIO - CONFIGURACION DE ENTORNO (.env.example)
# ==============================================================================
# Plantilla de variables de entorno. Copia este archivo a .env y define tus valores reales.
# NUNCA subas archivos .env con credenciales reales a repositorios públicos de Git.

APP_ENV=production
DEBUG=false
PORT=8081
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Conexión Supabase PostgreSQL (Configurar en Vercel -> Environment Variables)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres

# Supabase API & Storage Bucket
SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=econode-vault

# ------------------------------------------------------------------------------
# Seguridad de Sesiones y Claves Criptográficas
# ------------------------------------------------------------------------------
SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_EXPIRATION_HOURS=72
PASSWORD_SALT=change_this_to_a_secure_random_salt_in_production

# Almacenamiento Documental ('supabase' en Vercel, 'local' en desarrollo offline)
STORAGE_BACKEND=local

# Google Identity Services (Opcional)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
ADMIN_EMAILS=admin@example.com

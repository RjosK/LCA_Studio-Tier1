{
  "version": 2,
  "rewrites": [
    { "source": "/api/:match*", "destination": "/api/index.py?__slug=:match*" },
    { "source": "/css/(.*)", "destination": "/css/$1" },
    { "source": "/js/(.*)", "destination": "/js/$1" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}

{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/css/(.*)", "destination": "/econode_studio/web/css/$1" },
    { "source": "/js/(.*)", "destination": "/econode_studio/web/js/$1" },
    { "source": "/", "destination": "/econode_studio/web/index.html" },
    { "source": "/index.html", "destination": "/econode_studio/web/index.html" },
    { "source": "/(.*)", "destination": "/econode_studio/web/$1" }
  ]
}

